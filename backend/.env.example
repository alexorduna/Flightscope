# Port the Express backend listens on (optional, default 4000)
PORT=4000

# Allowed CORS origin - the frontend's dev URL (optional, default http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# SerpApi key (https://serpapi.com/) to activate real flight search via the
# "google_flights" engine (https://serpapi.com/google-flights-api).
#
# As long as this variable does NOT exist, the backend uses ONLY in-memory
# mock data - no code change is needed to activate the real API, just add
# your key below and restart the backend.
SERPAPI_KEY=

# TTL of the in-memory search results cache, in minutes (optional, default 30)
CACHE_TTL_MINUTES=30
